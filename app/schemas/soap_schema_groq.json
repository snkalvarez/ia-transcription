{
  "name": "nota_intermedia",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "subjetivo": {
        "type": "string",
        "description": "Texto correspondiente al subjetivo."
      },
      "objetivo": {
        "type": "string",
        "description": "Texto correspondiente al objetivo."
      },
      "analisis": {
        "type": "string",
        "description": "Texto correspondiente al análisis."
      },
      "plan": {
        "type": "string",
        "description": "Texto correspondiente al plan."
      },
      "infeccionIntrahospitalaria": {
        "type": "string",
        "enum": [
          "",
          "SI",
          "NO"
        ]
      },
      "escalaDolor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "",
              "ADULTOS",
              "PEDIATRICA",
              "NEONATAL"
            ]
          },
          "valor": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          }
        },
        "required": [
          "tipo",
          "valor"
        ]
      },
      "educacionPaciente": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "realizada": {
            "type": "string",
            "enum": [
              "",
              "SI",
              "NO"
            ]
          },
          "explicacion": {
            "type": "string"
          }
        },
        "required": [
          "realizada",
          "explicacion"
        ]
      },
      "diagnosticos": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codigo": {
              "type": "string"
            },
            "nombre": {
              "type": "string"
            },
            "principal": {
              "type": "boolean"
            },
            "tipo": {
              "type": "string",
              "enum": [
                "",
                "PRESUNTIVO",
                "DEFINITIVO"
              ]
            },
            "clase": {
              "type": "string",
              "enum": [
                "",
                "IMPRESION_DIAGNOSTICA",
                "CONFIRMADO_NUEVO",
                "CONFIRMADO_REPETIDO"
              ]
            },
            "clasificacion": {
              "type": "string",
              "enum": [
                "",
                "NO_CORRESPONDE",
                "PREOPERATORIO",
                "POSOPERATORIO",
                "HISTOPATOLOGICO"
              ]
            },
            "observacion": {
              "type": "string"
            }
          },
          "required": [
            "codigo",
            "nombre",
            "principal",
            "tipo",
            "clase",
            "clasificacion",
            "observacion"
          ]
        }
      },
      "indicacionMedica": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "",
              "HOSPITALIZACION",
              "URGENCIAS_OBSERVACION",
              "CIRUGIA",
              "REMISION",
              "MORGUE",
              "SALIDA",
              "SALIDA_CONSULTA_EXTERNA"
