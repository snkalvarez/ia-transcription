          "finalidadConsulta": {
            "type": "string"
          },
          "condicionDestino": {
            "type": "string",
            "enum": [
              "",
              "NINGUNA",
              "PACIENTE_CON_DESTINO_A_SU_DOMICILIO",
              "PACIENTE_MUERTO",
              "REFERIDO_A_OTRA_INSTITUCION",
              "CONTRAREFERIDO_A_OTRA_INSTITUCION",
              "HOSPITALIZACION_DOMICILIARIA",
              "DERIVADO_A_SERVICIO_SOCIAL",
              "PACIENTE_CONTINUA_EN_EL_SERVICIO"
            ]
          },
          "detalle": {
            "type": "string"
          },
          "finalizarAtencion": {
            "type": "boolean"
          }
        },
        "required": [
          "tipo",
          "causaExterna",
          "finalidadConsulta",
          "condicionDestino",
          "detalle",
          "finalizarAtencion"
        ]
      }
    },
    "required": [
      "subjetivo",
      "objetivo",
      "analisis",
      "plan",
      "infeccionIntrahospitalaria",
      "escalaDolor",
      "educacionPaciente",
      "diagnosticos",
      "indicacionMedica"
    ]
  }
}