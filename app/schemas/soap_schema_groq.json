          "causaExterna": {
            "type": "string",
            "enum": [
              "",
              "NINGUNA",
              "ACCIDENTE_TRABAJO",
              "ACCIDENTE_TRANSITO",
              "ACCIDENTE_RABICO",
              "ACCIDENTE_OFIDICO",
              "OTRO_TIPO_ACCIDENTE",
              "EVENTO_CATASTROFICO",
              "LESION_POR_AGRESION",
              "LESION_AUTOINFLINGIDA",
              "SOSPECHA_MALTRATO_FISICO",
              "SOSPECHA_ABUSO_SEXUAL",
              "SOSPECHA_VIOLENCIA_SEXUAL",
              "SOSPECHA_MALTRATO_EMOCIONAL",
              "ENFERMEDAD_GENERAL",
              "ENFERMEDAD_PROFESIONAL",
              "OTRA"
            ]
